+  port.metadata = async () => { throw original; };
+  await assert.rejects(() => storeStorageAttachment(port, request()), (e: any) => e.phase === "preflight" && e.code === original.code && e.cause === original && !e.retryable);
+  assert.equal(port.creates.length, 0);
+});
